{
  "name": "qarta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "dev:web": "turbo dev --filter=@qarta/web",
    "dev:api": "turbo dev --filter=@qarta/api",
    "dev:dashboard": "turbo dev --filter=@qarta/dashboard",
    "db:generate": "turbo db:generate --filter=@qarta/api",
    "db:migrate": "turbo db:migrate --filter=@qarta/api",
    "db:studio": "turbo db:studio --filter=@qarta/api",
    "db:seed": "turbo db:seed --filter=@qarta/api",
    "test": "turbo test --filter=@qarta/api",
    "test:e2e": "npm run test:e2e --workspace=apps/dashboard"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.2.7",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.0"
}
