# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://qarta:qarta@localhost:5432/qarta

# Redis
REDIS_URL=redis://localhost:6379

# Stripe (the only PSP)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# STRIPE_CLIENT_ID no longer needed — using Account Links for Connect onboarding

# Error monitoring (optional)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# API Keys (for merchant auth)
API_KEY_SALT=change-this-to-random-string

# Dashboard URL (for redirect URLs in Stripe Checkout / Portal)
DASHBOARD_URL=http://localhost:3001

# CORS (comma-separated origins for production)
CORS_ORIGINS=https://qarta.eu,https://app.qarta.eu

# Email notifications (optional)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxx
EMAIL_FROM=alerts@qarta.eu
